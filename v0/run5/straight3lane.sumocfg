<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <input>
        <net-file value="straight3lane.net.xml"/>
        <route-files value="straight3lane.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <lateral-resolution value="0.25"/>
        <time-to-teleport value="-1"/>
    </processing>

    <collision>
        <collision.action value="warn"/>
    </collision>

    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>

</configuration>
