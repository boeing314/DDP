<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="traffic3lane.net.xml"/>
        <route-files value="traffic3lane.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <lateral-resolution value="0.25"/>
    </processing>
    <output>
        <collision-output value="collisions.xml"/>
    </output>
</configuration>

