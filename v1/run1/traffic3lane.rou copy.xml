<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- =========================================================
         VEHICLE TYPES
         Based on Keshav Report - Table 3 + Table 8
         ========================================================= -->

    <!-- 2W - Bike -->
    <vType id="bike"
           carFollowModel="Krauss"
           laneChangeModel="SL2015"
           accel="6"
           decel="10"
           sigma="0.5"
           length="1.8"
           width="0.6"
           minGap="0.383637"
           maxSpeed="22.22"
           speedDev="0.1"
           lcSublane="1"
           lcPushy="0"
           lcAssertive="0"
           lcImpatience="0"
           latAlignment="nice"/>


    <!-- 3W - Auto -->
    <vType id="auto"
           carFollowModel="Krauss"
           laneChangeModel="SL2015"
           accel="1.5"
           decel="2"
           sigma="0.334265"
           length="2.6"
           width="1.4"
