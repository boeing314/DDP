    <!-- =========================================================
         ROUTE
         ========================================================= -->

    <route id="r_forward" edges="e0"/>


    <!-- =========================================================
         TRAFFIC FLOWS
         ========================================================= -->

    <flow id="fwd_bike"
          type="bike"
          route="r_forward"
          begin="0"
          end="3600"
          vehsPerHour="2160"
